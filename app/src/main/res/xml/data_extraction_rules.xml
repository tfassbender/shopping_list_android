<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: the server holds the data, and the session token is encrypted
     with a Keystore key that doesn't exist on another device anyway. A fresh install simply logs in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
